# =============================================================================
# ADK Composite Memory Platform — Environment Configuration
# Copy to `.env` and set your API keys / database endpoints.
# =============================================================================

# 1. LLM & Embedding Providers (`gemini` | `bedrock` | `openai` | `ollama` | `local_st` | `deterministic`)
GOOGLE_API_KEY=
MEMORY_LIVE_GEMINI=1
ADK_LLM_PROVIDER=gemini
ADK_LLM_MODEL=gemini-2.5-flash
ADK_EMBEDDING_PROVIDER=gemini
ADK_EMBEDDING_MODEL=text-embedding-004

# Optional: Amazon Bedrock / OpenAI / Ollama settings
AWS_REGION=us-east-1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 2. Storage Stack Preset (`docker` | `postgres_only` | `redis_only` | `memory`)
MEMORY_BACKEND=docker

# Or configure each port independently:
# ADK_REGISTRY_BACKEND=postgres
# ADK_SEED_BACKEND=postgres
# ADK_GRAPH_BACKEND=neo4j
# ADK_PLAYBOOK_BACKEND=redis

POSTGRES_DSN=postgresql://platform_admin:platform_secret@127.0.0.1:5433/adk_memory_platform
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=platform_secret
REDIS_URL=redis://127.0.0.1:6379/0
