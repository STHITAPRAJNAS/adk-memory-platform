      "range_class": "Asset",
      "is_functional": false,
      "is_transitive": true
    },
    "OWNED_BY": {
      "predicate": "OWNED_BY",
      "domain_class": "Asset",
      "range_class": "EngineeringSquad",
      "is_functional": true
    },
    "IMPACTS_ASSET": {
      "predicate": "IMPACTS_ASSET",
      "domain_class": "Incident",
      "range_class": "Asset",
      "is_functional": false
    }
  }
