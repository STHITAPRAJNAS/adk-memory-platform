    "SoftwareAsset": "Asset",
    "InfrastructureAsset": "Asset",
    "Microservice": "SoftwareAsset",
    "DatabaseCluster": "InfrastructureAsset",
    "CloudRegion": "p:Concept",
    "EngineeringSquad": "p:Actor",
